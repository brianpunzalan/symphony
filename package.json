{
  "name": "symphony",
  "version": "0.1.0",
  "description": "Symphony - automated coding agent orchestration service",
  "main": "dist/index.js",
  "bin": {
    "symphony": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:server": "tsc",
    "build:client": "cd client && npm install && npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
